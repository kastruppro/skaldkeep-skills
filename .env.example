# Skaldkeep skills - environment variables
# Copy to `.env` (gitignored) or export them in your shell profile.
# These are read from the environment only; never paste them into a committed file.

# Base URL of your Skaldkeep instance (no trailing slash). The MCP lives at <url>/mcp.
SKALDKEEP_URL=https://app.skaldkeep.gg

# Personal access token. Create one in Skaldkeep under Settings > Access tokens.
# It starts with skp_ and is shown only once.
SKALDKEEP_TOKEN=

# Only for the skaldkeep-transcribe-local skill: an AssemblyAI API key.
ASSEMBLYAI_API_KEY=
